# Build stage
FROM eclipse-temurin:25-jdk-alpine AS builder
WORKDIR /app
COPY .mvn .mvn
COPY mvnw pom.xml ./
COPY common common
COPY optimized optimized
RUN ./mvnw package -pl optimized -am -DskipTests

# Runtime stage
FROM eclipse-temurin:25-jre-alpine
WORKDIR /app
COPY --from=builder /app/optimized/target/optimized-*.jar app.jar

EXPOSE 8081
ENV JAVA_OPTS="-XX:+UseZGC -XX:MaxGCPauseMillis=100 -Xms2G -Xmx2G -XX:+AlwaysPreTouch -XX:+UseCompressedOops"
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
